MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/decoracao-de-cheio
PORT=3000

# Chave simples para acederes à área de admin (/admin) e responderes aos clientes.
# Escolhe algo só teu, tipo uma password longa. Ninguém mais deve saber isto.
ADMIN_KEY=escolhe-uma-chave-secreta-tua

# Chave usada para assinar as sessões de login (clientes). Escolhe uma frase longa e aleatória.
JWT_SECRET=escolhe-outra-chave-secreta-longa-e-diferente

# Credenciais do "Sign in with Google" — cria-as em https://console.cloud.google.com/apis/credentials
# (tipo de credencial: "ID de cliente OAuth", tipo de aplicação: "Aplicação Web")
GOOGLE_CLIENT_ID=o-teu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=o-teu-client-secret
